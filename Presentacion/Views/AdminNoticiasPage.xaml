<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PintagAPP.Presentacion.ViewModels"
             x:Class="PintagAPP.Presentacion.Views.AdminNoticiasPage"
             x:DataType="vm:AdminNoticiasViewModel"
             Title="Noticias">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" />
            <Label Text="{Binding Aviso}" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Noticias}"
                        SelectionMode="Single" SelectedItem="{Binding NoticiaSeleccionada}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AdminNoticiaItem">
                    <Border Margin="0,6" Padding="10" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F2F6FA, Dark=#2A2A2A}">
                        <Grid ColumnDefinitions="70,*" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="70" HeightRequest="70" Stroke="Transparent"
                                    StrokeShape="RoundRectangle 8" BackgroundColor="LightGray">
                                <Grid>
                                    <Label Text="📰" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding ImagenUrl}" Aspect="AspectFill" IsVisible="{Binding TieneImagen}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" MaxLines="2" />
                                <Label Text="{Binding Estado}" FontSize="13" />
                                <Label Text="{Binding Fecha}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="➕ Nueva noticia" Command="{Binding NuevaCommand}"
                BackgroundColor="#2E7D32" TextColor="White" />
    </Grid>
</ContentPage>