<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PintagAPP.Presentacion.ViewModels"
             x:Class="PintagAPP.Presentacion.Views.BuscarPage"
             x:DataType="vm:BuscarViewModel"
             Title="Buscar">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">

        <SearchBar Grid.Row="0" x:Name="buscador" Text="{Binding Texto}"
                   Placeholder="Buscar servicios o productos"
                   SearchCommand="{Binding BuscarCommand}" />

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" />
            <Label Text="{Binding Aviso}" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Resultados}"
                        SelectionMode="Single" SelectedItem="{Binding OfertaSeleccionada}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:OfertaPublicaResumen">
                    <Border Margin="0,6" Padding="10" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F2F6FA, Dark=#2A2A2A}">
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="100" HeightRequest="100" Stroke="Transparent"
                                    StrokeShape="RoundRectangle 10" BackgroundColor="LightGray">
                                <Grid>
                                    <Label Text="📷" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding FotoUrl}" Aspect="AspectFill" IsVisible="{Binding TieneFoto}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" MaxLines="2" />
                                <Label Text="{Binding Precio}" FontSize="15" TextColor="Green" FontAttributes="Bold" />
                                <Label Text="{Binding Oferente}" FontSize="13" />
                                <Label Text="{Binding Calificacion}" FontSize="12" TextColor="#F9A825" />
                                <Label Text="{Binding Barrio, StringFormat='📍 {0}'}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>