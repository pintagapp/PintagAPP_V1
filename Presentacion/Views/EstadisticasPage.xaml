<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PintagAPP.Presentacion.ViewModels"
             x:Class="PintagAPP.Presentacion.Views.EstadisticasPage"
             x:DataType="vm:EstadisticasViewModel"
             Title="Estadísticas">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" />
            <Label Text="{Binding Aviso}" FontSize="12" TextColor="Gray" />

            <Label Text="Resumen general" FontSize="18" FontAttributes="Bold" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Indicadores}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:IndicadorItem">
                        <Border Padding="12" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F2F6FA, Dark=#2A2A2A}">
                            <Grid ColumnDefinitions="40,*,Auto">
                                <Label Text="{Binding Emoji}" FontSize="22" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Titulo}" FontSize="14" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Valor}" FontSize="16" FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Por categoría" FontSize="18" FontAttributes="Bold" Margin="0,12,0,0" />
            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Categorias}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoriaEstadisticaItem">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,6">
                            <Label Text="{Binding Nombre}" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding Detalle}" FontSize="13" TextColor="Gray" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="🔄 Actualizar" Command="{Binding RecargarCommand}" Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>