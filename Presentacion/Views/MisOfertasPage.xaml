<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PintagAPP.Presentacion.ViewModels"
             x:Class="PintagAPP.Presentacion.Views.MisOfertasPage"
             x:DataType="vm:MisOfertasViewModel"
             Title="Mis ofertas">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="Puedes tener hasta 2 ofertas. Toca una para editarla." TextColor="Gray" FontSize="13" />
            <Label Text="{Binding Aviso}" IsVisible="{Binding TieneAviso}" FontSize="14" />
            <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Ofertas}"
                        SelectionMode="Single" SelectedItem="{Binding OfertaSeleccionada}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:OfertaResumen">
                    <Border Margin="0,6" Padding="10" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F2F6FA, Dark=#2A2A2A}">
                        <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="80" HeightRequest="80"
                                    StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="LightGray">
                                <Grid>
                                    <Label Text="📦" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding FotoUrl}" Aspect="AspectFill" IsVisible="{Binding TieneFoto}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Tipo}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Precio}" FontSize="15" TextColor="Green" FontAttributes="Bold" />
                                <Label Text="{Binding EstadoTexto}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="➕ Nueva oferta" Command="{Binding NuevaCommand}"
                IsVisible="{Binding PuedeCrear}" />
    </Grid>
</ContentPage>