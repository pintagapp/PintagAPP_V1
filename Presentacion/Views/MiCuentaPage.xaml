<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PintagAPP.Presentacion.ViewModels"
             x:Class="PintagAPP.Presentacion.Views.MiCuentaPage"
             x:DataType="vm:MiCuentaViewModel"
             Title="Mi cuenta">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="👤" FontSize="56" HorizontalOptions="Center" />
            <Label Text="{Binding Nombre}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="{Binding RolTexto}" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />

            <Button Text="📄 Política de privacidad" Command="{Binding VerPoliticaCommand}" Margin="0,20,0,0" />

            <Border Padding="14" Margin="0,30,0,0" Stroke="#C62828" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Eliminar mi cuenta" FontSize="16" FontAttributes="Bold" TextColor="#C62828" />
                    <Label FontSize="13" TextColor="Gray"
                           Text="Puedes eliminar tu cuenta cuando quieras (derecho de eliminación, LOPDP). Se borran tu negocio, ofertas, fotos, calificaciones y denuncias. No se puede deshacer." />
                    <Button Text="🗑️ Eliminar mi cuenta" Command="{Binding EliminarCuentaCommand}"
                            BackgroundColor="#C62828" TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>