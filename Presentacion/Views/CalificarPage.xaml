<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PintagAPP.Presentacion.ViewModels"
             x:Class="PintagAPP.Presentacion.Views.CalificarPage"
             x:DataType="vm:CalificarViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="{Binding NombreOferente}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="¿Cómo te atendió?" FontSize="15" TextColor="Gray" HorizontalOptions="Center" />

            <!-- 5 estrellas que se tocan -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="{Binding Estrella1}" FontSize="44" TextColor="#F9A825">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ElegirEstrellasCommand}" CommandParameter="1" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Estrella2}" FontSize="44" TextColor="#F9A825">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ElegirEstrellasCommand}" CommandParameter="2" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Estrella3}" FontSize="44" TextColor="#F9A825">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ElegirEstrellasCommand}" CommandParameter="3" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Estrella4}" FontSize="44" TextColor="#F9A825">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ElegirEstrellasCommand}" CommandParameter="4" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Estrella5}" FontSize="44" TextColor="#F9A825">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ElegirEstrellasCommand}" CommandParameter="5" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
            <Label Text="{Binding TextoEstrellas}" FontSize="16" HorizontalOptions="Center" />

            <Label Text="Comentario (opcional)" FontSize="14" Margin="0,10,0,0" />
            <Editor Text="{Binding Comentario}" Placeholder="Cuenta cómo fue tu experiencia"
                    MaxLength="300" HeightRequest="120" />
            <Label Text="{Binding ContadorTexto}" FontSize="12" TextColor="Gray" HorizontalOptions="End" />

            <Label Text="Tu opinión se publica como «Usuario de Píntag», sin tu nombre."
                   FontSize="12" TextColor="Gray" />

            <Button Text="Guardar calificación" Command="{Binding GuardarCommand}"
                    BackgroundColor="#F9A825" TextColor="Black" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>