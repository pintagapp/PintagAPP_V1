<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PintagAPP.Presentacion.ViewModels"
             x:Class="PintagAPP.Presentacion.Views.PorCalificarPage"
             x:DataType="vm:PorCalificarViewModel"
             Title="Por calificar">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" />
            <Label Text="{Binding Aviso}" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Perfiles}"
                        SelectionMode="Single" SelectedItem="{Binding PerfilSeleccionado}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PerfilPorCalificar">
                    <Border Margin="0,6" Padding="10" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F2F6FA, Dark=#2A2A2A}">
                        <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="60" HeightRequest="60"
                                    StrokeShape="RoundRectangle 30" Stroke="Transparent" BackgroundColor="LightGray">
                                <Grid>
                                    <Label Text="👤" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding FotoUrl}" Aspect="AspectFill" IsVisible="{Binding TieneFoto}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Barrio, StringFormat='📍 {0}'}" FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="⭐ Calificar" FontSize="14" TextColor="#F9A825"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>