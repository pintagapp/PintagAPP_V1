<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PintagAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PintagAPP.Presentacion.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Píntag Conecta">

    <TabBar>
        <ShellContent Title="Inicio"    Icon="inicio.png"   ContentTemplate="{DataTemplate views:InicioPage}"   Route="InicioPage" />
        <ShellContent Title="Buscar"    Icon="buscar.png"   ContentTemplate="{DataTemplate views:BuscarPage}"   Route="BuscarPage" />
        <ShellContent Title="Noticias"  Icon="noticias.png" ContentTemplate="{DataTemplate views:NoticiasPage}" Route="NoticiasPage" />
        <ShellContent Title="Mi perfil" Icon="perfil.png"   ContentTemplate="{DataTemplate views:MiPerfilPage}" Route="MiPerfilPage" />
    </TabBar>

</Shell>